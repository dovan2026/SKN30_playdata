# 환경 변수 (보안 토큰 / API 키 보호 - 절대 커밋 금지)
.env
.env.*
!.env.sample
!.env.example
.env.local

# 가상환경
.venv/
venv/
env/

# Python 캐시 및 빌드 관련
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# 로컬 SQLite 데이터베이스 파일
data/
*.sqlite
*.db

# IDE 설정 파일
.vscode/
.idea/

# 대용량 바이너리 파일 (GitHub 50MB 제한 초과)
*.exe
cloudflared*
